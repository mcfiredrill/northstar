package pages

import (
	"github.com/starfederation/datastar-go/datastar"
	"northstar/features/common/components"
	"northstar/features/common/layouts"
)

templ ChatMessages(messages []string) {
  <ul id="messages">
    for _, message := range messages {
      <li>{ message }</li>
    }
  </ul>
}

templ ChatPage() {
	@layouts.Base("Chat") {
		@components.Navigation(components.PageChat)
    <center>
      <marquee>da chat</marquee>
      <ul
        data-init={ datastar.GetSSE("/messages") }
        id="messages">
      </ul>
      <form
        data-on:submit={ datastar.PostSSE("/messages") }
        >
        <input data-bind:message name="message" class="border-solid border-2 border-purple" type="text" />
        <button class="bg-sky-300 p-2" type="submit">Send</button>
      </form>
    </center>
	}
}
